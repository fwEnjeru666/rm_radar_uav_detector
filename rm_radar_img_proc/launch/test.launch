<launch>        
      <arg name="imgProc_params_right" default="$(find rm_radar_img_proc)/config/params_right.yaml"/>
      <node pkg="nodelet" type="nodelet" name="right_camera_Processor" 
            args="manager"
            output="screen" 
            respawn="true">
      </node>

      <node pkg="nodelet" type="nodelet" name="hk_camera_right"
            args="load hk_camera/HKCameraNodelet right_camera_Processor"
            output="screen" 
            respawn="true">
            
            <param name="camera_info_url" value="file://$(find hk_camera)/config/DA1487938.yaml"/>
            <param name="camera_sn" value="00DA1487938"/>
            <param name="frame_id" value="camera_right_optical_frame"/>
            <remap from="image_raw" to="/hk_camera_right/image_raw" />
            <remap from="camera_info" to="/hk_camera_right/camera_info" />
      </node>

      <node pkg="nodelet" type="nodelet" name="Processor_right"
            args="load rm_radar_img_proc/Processor right_camera_Processor" 
            output="screen"
            respawn="true">     
            
            <rosparam command="load" file="$(arg imgProc_params_right)" />
            <remap from="/processor/single_result_msg" to="/right_camera_Processor/processor/single_result_msg"/>
            <remap from="debug_image" to="/right_camera_Processor/debug_image"/>
            
            <remap from="/hk_camera/image_raw" to="/hk_camera_right/image_raw"/>
            <remap from="/hk_camera/camera_info" to="/hk_camera_right/camera_info"/>
            
      </node>

</launch>