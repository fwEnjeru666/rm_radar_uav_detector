<!--
  test_imgproc.launch — Test the imgproc pipeline with a single image or video

  Usage examples:
    # Test with a single image (loops at 2 fps)
    roslaunch rm_radar_img_proc test_imgproc.launch image:=/path/to/image.jpg

    # Test with a video file
    roslaunch rm_radar_img_proc test_imgproc.launch video:=/path/to/video.mp4

    # With real camera calibration
    roslaunch rm_radar_img_proc test_imgproc.launch image:=/path/to/image.jpg \
        camera_info:=file:///home/enjeru/radar_detection_moduel/src/hk_camera/config/DA1487938.yaml

    # Detect blue targets
    roslaunch rm_radar_img_proc test_imgproc.launch image:=/path/to/image.jpg target_color:=0

  While running, use rqt_reconfigure to tune:
    - preprocess_condition (HSV thresholds, binary thresh, morph)
    - armor_condition (bar/armor filter params)
    - draw_condition (select which debug view to publish)

  View result:
    rqt_image_view /nodelet_manager/radar_imgProc/debug_image
-->
<launch>
    <!-- =================== Input source =================== -->
    <arg name="image" default="" doc="Path to a single image file (jpg/png)"/>
    <arg name="video" default="" doc="Path to a video file (mp4/avi)"/>
    <arg name="camera_info" default="" doc="Camera calibration YAML URL, e.g. file:///path/to/calib.yaml"/>
    <arg name="fps" default="30.0" doc="Playback FPS (overridden by video FPS if available)"/>
    <arg name="loop" default="true" doc="Loop video playback"/>
    <arg name="target_color" default="1" doc="0=blue, 1=red"/>

    <!-- =================== Nodelet manager =================== -->
    <arg name="manager_name" default="nodelet_manager"/>

    <node pkg="nodelet" type="nodelet" name="$(arg manager_name)" args="manager" output="screen">
        <param name="num_worker_threads" value="4"/>
    </node>

    <!-- =================== Processor nodelet =================== -->
    <node pkg="nodelet" type="nodelet" name="processor"
          args="load rm_radar_img_proc/Processor $(arg manager_name)" output="screen">
        <remap from="/processor/result_msg" to="/processor/result_msg"/>
        <remap from="debug_image" to="debug_image"/>
        <!-- Override target color -->
        <param name="target_color" value="$(arg target_color)"/>
    </node>

    <!-- =================== Test image/video feeder =================== -->
    <node pkg="rm_radar_img_proc" type="imgproc_test_node" name="imgproc_test" output="screen">
        <param name="image" value="$(arg image)"/>
        <param name="video" value="$(arg video)"/>
        <param name="camera_info_url" value="$(arg camera_info)"/>
        <param name="image_topic" value="/hk_camera/image_raw"/>
        <param name="fps" value="$(arg fps)"/>
        <param name="loop" value="$(arg loop)"/>
    </node>

    <!-- =================== Static TF (processor needs this) =================== -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="fake_odom_tf"
          args="0 0 0 0 0 0 odom camera_optical_frame"/>

    <!-- =================== Visualization =================== -->
    <!-- Uncomment to auto-open rqt_image_view -->
    <!-- <node pkg="rqt_image_view" type="rqt_image_view" name="viewer"
          args="/nodelet_manager/radar_imgProc/debug_image"/> -->

</launch>
